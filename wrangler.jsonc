// Cloudflare Workers config: serves the static site in ./site.
// Spelled out here so preview builds (wrangler versions upload) work, not just production deploys.
{
  "name": "quintetechhelp",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page"
  }
}
